{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "monkeynotes",
  "version": "../package.json",
  "identifier": "com.nathansou.monkeynotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "monkeynotes",
        "width": 1200,
        "height": 780,
        "minWidth": 520,
        "minHeight": 360,
        "backgroundColor": "#323437",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.github.com/repos/nathanksou/monkeynotes/releases/latest; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Distraction-free notes",
    "publisher": "Nathan Sou",
    "copyright": "Copyright (C) 2026 Nathan Sou",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/nathanksou/monkeynotes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
